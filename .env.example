# OpenAI-compatible vision. Leave blank to save tickets without AI notes.
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini

# Twilio. Leave any of these blank to run texts in test mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email for quote and ready notices. Leave SMTP_HOST blank for test mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public https origin, no trailing slash. Used for text links and webhook signatures.
# On Render this falls back to RENDER_EXTERNAL_URL when left blank.
PUBLIC_BASE_URL=

# Persistent photos and SQLite. Use a disk mount in production.
DATA_DIR=./data

# Locks the staff bench. Leave blank for local development. Required in production.
STAFF_PASSWORD=

# Set to true to load sample tickets only when the database is empty. Never wipes existing tickets.
SEED_DEMO=false

# Free demo: wipe and reload sample tickets on every boot, and show the reset banner. No disk.
DEMO_MODE=false
